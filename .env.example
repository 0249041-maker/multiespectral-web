VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
# Recomendado (nombre oficial):
VITE_SUPABASE_ANON_KEY=tu_anon_key_publica
# Si en Vercel la creaste como VITE_SUPABASE_ANON_KE, el código también la acepta.

# Bucket de Storage (nombre en Supabase → Storage), no la tabla capture_images.
# Por defecto en código: capture_image
# VITE_SUPABASE_SPECTRAL_BUCKET=capture_image

# Vista en vivo (FocusLiveTest): URL por defecto del WebSocket (opcional).
# En Vercel (HTTPS) debe ser wss://… si expones el stream con TLS (túnel/proxy).
# Sin definir, el cliente usa la IP por defecto del código o lo guardado en localStorage.
# VITE_FOCUS_LIVE_WS_URL=wss://tu-tunel.ejemplo.com
